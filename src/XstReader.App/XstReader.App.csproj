<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/xst.ico</ApplicationIcon>
    <AssemblyName>Rxst</AssemblyName>
    <Product>Rxst</Product>
    <Title>Rxst</Title>
    <Description>Rxst mail archive viewer</Description>
    <Authors>rif009</Authors>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" Version="11.3.22" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.22" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.22" />
    <PackageReference Include="HtmlAgilityPack" Version="1.12.4" />
    <PackageReference Include="Avalonia.HtmlRenderer" Version="11.3.0" />
    <PackageReference Include="RtfPipe" Version="2.0.7677.4303" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.6" />
    <PackageReference Include="PdfPig" Version="0.1.16" />
    <PackageReference Include="ExcelDataReader" Version="3.8.0" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
    <ProjectReference Include="../XstReader.Core/XstReader.Core.csproj" />
  </ItemGroup>
  <ItemGroup><AvaloniaResource Include="Assets/**" /></ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="../../LICENSE" LogicalName="Rxst.LICENSE" />
    <EmbeddedResource Include="../../THIRD-PARTY-NOTICES.md" LogicalName="Rxst.THIRD-PARTY-NOTICES" />
  </ItemGroup>
</Project>
