<Application xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="XstReader.App.App" RequestedThemeVariant="Dark">
  <Application.Resources><ResourceDictionary><ResourceDictionary.ThemeDictionaries><ResourceDictionary x:Key="Dark"><SolidColorBrush x:Key="Canvas" Color="#17171D"/><SolidColorBrush x:Key="Header" Color="#1E1E26"/><SolidColorBrush x:Key="Rail" Color="#141419"/><SolidColorBrush x:Key="Sidebar" Color="#1D1D24"/><SolidColorBrush x:Key="List" Color="#1A1A21"/><SolidColorBrush x:Key="Reader" Color="#202027"/><SolidColorBrush x:Key="Card" Color="#292931"/><SolidColorBrush x:Key="Input" Color="#25252E"/><SolidColorBrush x:Key="Border" Color="#30303A"/><SolidColorBrush x:Key="BorderSoft" Color="#2D2D36"/><SolidColorBrush x:Key="Divider" Color="#2B2B34"/><SolidColorBrush x:Key="ReaderBorder" Color="#32323C"/><SolidColorBrush x:Key="InputBorder" Color="#363540"/><SolidColorBrush x:Key="PrimaryText" Color="#E7E6EF"/><SolidColorBrush x:Key="MutedText" Color="#9492A6"/><SolidColorBrush x:Key="Selection" Color="#322A48"/><SolidColorBrush x:Key="Banner" Color="#252131"/><SolidColorBrush x:Key="BannerText" Color="#C5B5EF"/><SolidColorBrush x:Key="Avatar" Color="#353044"/><SolidColorBrush x:Key="AvatarText" Color="#CAB9F0"/><SolidColorBrush x:Key="AvatarLarge" Color="#45365F"/><SolidColorBrush x:Key="AvatarLargeText" Color="#D1BDF7"/><SolidColorBrush x:Key="FolderIcon" Color="#A99ACF"/><SolidColorBrush x:Key="LocalLabel" Color="#AFA0DB"/><SolidColorBrush x:Key="Unread" Color="#AD92EE"/><SolidColorBrush x:Key="Attachment" Color="#A89BC5"/><SolidColorBrush x:Key="Breadcrumb" Color="#AC96DD"/><SolidColorBrush x:Key="ActionText" Color="#BBA3EF"/><SolidColorBrush x:Key="EmptyIcon" Color="#8874B4"/></ResourceDictionary><ResourceDictionary x:Key="Light"><SolidColorBrush x:Key="Canvas" Color="#F4F4F8"/><SolidColorBrush x:Key="Header" Color="#FFFFFF"/><SolidColorBrush x:Key="Rail" Color="#EBEBF2"/><SolidColorBrush x:Key="Sidebar" Color="#F5F4F9"/><SolidColorBrush x:Key="List" Color="#FAFAFD"/><SolidColorBrush x:Key="Reader" Color="#FFFFFF"/><SolidColorBrush x:Key="Card" Color="#F1F0F6"/><SolidColorBrush x:Key="Input" Color="#EEEDF4"/><SolidColorBrush x:Key="Border" Color="#DCD9E7"/><SolidColorBrush x:Key="BorderSoft" Color="#E1DEEB"/><SolidColorBrush x:Key="Divider" Color="#E1DEEB"/><SolidColorBrush x:Key="ReaderBorder" Color="#E4E1ED"/><SolidColorBrush x:Key="InputBorder" Color="#D2CDDF"/><SolidColorBrush x:Key="PrimaryText" Color="#252232"/><SolidColorBrush x:Key="MutedText" Color="#6C657C"/><SolidColorBrush x:Key="Selection" Color="#E8DEF9"/><SolidColorBrush x:Key="Banner" Color="#EEE7FC"/><SolidColorBrush x:Key="BannerText" Color="#675086"/><SolidColorBrush x:Key="Avatar" Color="#E8E0F5"/><SolidColorBrush x:Key="AvatarText" Color="#68508E"/><SolidColorBrush x:Key="AvatarLarge" Color="#E8DEF9"/><SolidColorBrush x:Key="AvatarLargeText" Color="#68508E"/><SolidColorBrush x:Key="FolderIcon" Color="#76628F"/><SolidColorBrush x:Key="LocalLabel" Color="#76628F"/><SolidColorBrush x:Key="Unread" Color="#7E5DB4"/><SolidColorBrush x:Key="Attachment" Color="#76628F"/><SolidColorBrush x:Key="Breadcrumb" Color="#7A58A9"/><SolidColorBrush x:Key="ActionText" Color="#7654AB"/><SolidColorBrush x:Key="EmptyIcon" Color="#8E77AE"/></ResourceDictionary></ResourceDictionary.ThemeDictionaries><Color x:Key="SystemAccentColor">#9673D8</Color></ResourceDictionary></Application.Resources>
  <Application.Styles>
    <FluentTheme />
    <Style Selector="Window"><Setter Property="FontFamily" Value="Inter, Segoe UI"/><Setter Property="FontSize" Value="13"/><Setter Property="Background" Value="{DynamicResource Canvas}"/></Style>
    <Style Selector="TextBlock"><Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/></Style>
    <Style Selector="TextBlock.muted"><Setter Property="Foreground" Value="{DynamicResource MutedText}"/></Style>
    <Style Selector="Button"><Setter Property="CornerRadius" Value="7"/><Setter Property="Padding" Value="13,9"/></Style>
    <Style Selector="Button.accent"><Setter Property="Background" Value="#7860CB"/><Setter Property="Foreground" Value="White"/></Style>
    <Style Selector="Button.ghost"><Setter Property="Background" Value="Transparent"/></Style>
    <Style Selector="Button.repository"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="0"/><Setter Property="MinHeight" Value="0"/><Setter Property="Cursor" Value="Hand"/></Style>
    <Style Selector="Button.repository:pointerover TextBlock"><Setter Property="TextDecorations" Value="Underline"/></Style>
    <Style Selector="Button.repository:pointerover /template/ ContentPresenter"><Setter Property="Background" Value="Transparent"/></Style>
    <Style Selector="TextBox"><Setter Property="CornerRadius" Value="7"/><Setter Property="Background" Value="{DynamicResource Input}"/><Setter Property="BorderBrush" Value="{DynamicResource InputBorder}"/></Style>
    <Style Selector="ListBoxItem"><Setter Property="Padding" Value="12"/><Setter Property="Margin" Value="4,2"/><Setter Property="CornerRadius" Value="7"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="MinHeight" Value="96"/></Style>
    <Style Selector="ListBoxItem:selected /template/ ContentPresenter"><Setter Property="Background" Value="{DynamicResource Selection}"/></Style>
    <Style Selector="TreeViewItem"><Setter Property="MinHeight" Value="40"/><Setter Property="IsExpanded" Value="{Binding Expanded, Mode=TwoWay}"/><Setter Property="Padding" Value="4,2"/></Style>
  </Application.Styles>
</Application>



